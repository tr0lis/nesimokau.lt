# Nukopijuok į .env.local (lokaliai) arba įrašyk kaip Environment Variables Vercel'yje.
# NIEKADA nekomituok tikro .env failo.

# PocketBase adresas (lokaliai: http://127.0.0.1:8090)
POCKETBASE_URL=http://127.0.0.1:8090
# PocketBase superuser (sukuriamas pirmą kartą paleidus PocketBase)
PB_ADMIN_EMAIL=admin@example.com
PB_ADMIN_PASSWORD=pakeisk-i-ilga-slaptazodi

# >= 32 simbolių atsitiktinė eilutė:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=
# 32 baitų raktas base64:            node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOTP_ENC_KEY=

# Kableliais atskirti leidžiami adresai (produkcijoje)
ALLOWED_ORIGINS=https://nesimokau.lt,https://www.nesimokau.lt
TOTP_ISSUER=nesimokau.lt

# Tik migracijai iš Supabase (scripts/migrate-supabase-to-pocketbase.mjs)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
