<svg class="glyph-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    @switch (Key)
    {
        case "dictation":
            <path d="M4 14v-2a8 8 0 0 1 16 0v2" /><path d="M4 14h3v5H5.5A1.5 1.5 0 0 1 4 17.500zM20 14h-3v5h1.500a1.500 1.500 0 0 0 1.500-1.500z" />
            break;
        case "spelling":
            <circle cx="12" cy="12" r="9" /><path d="m8 12.500 2.700 2.700L16 9.500" />
            break;
        case "missing-letters":
            <path d="M5 18h5M14 18h5" /><path d="m6.500 14 3-8 3 8M7.600 11.500h3.800" />
            break;
        case "accentuation":
            <path d="m7 19 5-13 5 13M8.900 14.500h6.200M12.500 2.500l2 2" />
            break;
        case "word-match":
            <path d="M4 8h14m-3-3 3 3-3 3M20 16H6m3-3-3 3 3 3" />
            break;
        case "synonyms":
            <circle cx="9" cy="12" r="5.500" /><circle cx="15" cy="12" r="5.500" />
            break;
        case "sentence-builder":
            <path d="M4 7h10M4 12h16M4 17h7" />
            break;
        case "quiz":
            <path d="M13 3 5 13.500h6L10 21l8-10.500h-6z" />
            break;
        case "math-arena":
            <rect x="5" y="3" width="14" height="18" rx="3" /><path d="M8.500 7.500h7M9 12h.01M12 12h.01M15 12h.01M9 16h.01M12 16h.01M15 16h.01" />
            break;
        case "math-word-problems":
            <circle cx="12" cy="12" r="9" /><path d="M9.200 9.300a2.900 2.900 0 1 1 4.600 2.300c-1 .7-1.800 1.200-1.800 2.400M12 17h.01" />
            break;
        case "math-geometry":
            <path d="M3.500 19 12 4.500 20.500 19z" /><path d="M8 19v-2.500M12 19v-3M16 19v-2.500" />
            break;
        case "math-patterns":
            <circle cx="5.500" cy="12" r="2.500" /><rect x="10" y="9.500" width="5" height="5" rx="1" /><path d="m19.500 9.500 2.500 5h-5z" />
            break;
        case "english":
        case "Anglų kalba":
            <circle cx="12" cy="12" r="9" /><path d="M3 12h18M12 3c3.200 3 3.200 15 0 18M12 3c-3.200 3-3.200 15 0 18" />
            break;
        case "history":
        case "Istorija":
            <path d="M3.500 10 12 4l8.500 6zM5 20h14M6.500 10v10M10 10v10M14 10v10M17.500 10v10" />
            break;
        case "science":
        case "Gamtos mokslai":
            <path d="M9 3h6M10 3v6l-5 9.500A1.800 1.800 0 0 0 6.600 21h10.800a1.800 1.800 0 0 0 1.600-2.500L14 9V3M8 15h8" />
            break;
        case "Informatika":
            <path d="m8 7-5 5 5 5m8-10 5 5-5 5m-2-12-4 14" />
            break;
        case "Matematika":
            <rect x="5" y="3" width="14" height="18" rx="3" /><path d="M8.500 7.500h7M9 12h.01M12 12h.01M15 12h.01M9 16h.01M12 16h.01M15 16h.01" />
            break;
        default:
            <path d="M4 5h5.500A2.500 2.500 0 0 1 12 7.500V20a2.500 2.500 0 0 0-2.500-2.500H4zM20 5h-5.500A2.500 2.500 0 0 0 12 7.500V20a2.500 2.500 0 0 1 2.500-2.500H20z" />
            break;
    }
</svg>

@code {
    /// <summary>Game id or subject title.</summary>
    [Parameter, EditorRequired] public string Key { get; set; } = string.Empty;
}
