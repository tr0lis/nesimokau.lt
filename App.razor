@using nesimokau.lt.Services
@implements IDisposable

<Router AppAssembly="@typeof(App).Assembly" NotFoundPage="typeof(Pages.NotFound)">
    <Found Context="routeData">
        <ErrorBoundary>
            <ChildContent>
                <RouteView RouteData="@routeData" DefaultLayout="@typeof(MainLayout)" />
                <FocusOnNavigate RouteData="@routeData" Selector="h1" />
            </ChildContent>
            <ErrorContent Context="exception">
                <LayoutView Layout="@typeof(MainLayout)">
                    <section class="error-page">
                        <p class="eyebrow">KAŽKAS NENUTIKO TAIP, KAIP PLANAVOME</p>
                        <h1>Šį puslapį reikia <span class="gradient-text">įkelti iš naujo.</span></h1>
                        <p class="subtitle">Tavo išsaugoti rezultatai liko naršyklėje.</p>
                        <button class="button button-primary" @onclick="Reload">Įkelti iš naujo</button>
                    </section>
                </LayoutView>
            </ErrorContent>
        </ErrorBoundary>
    </Found>
</Router>

@code {
    [Inject]
    private AuthService Auth { get; set; } = default!;

    private void Reload() => NavigationManager.NavigateTo(NavigationManager.Uri, forceLoad: true);

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        NavigationManager.LocationChanged += HandleLocationChanged;
        await EnforceAuthAsync(NavigationManager.Uri);
    }

    private async void HandleLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        await EnforceAuthAsync(e.Location);
    }

    private async Task EnforceAuthAsync(string absoluteUri)
    {
        var relativePath = NavigationManager.ToBaseRelativePath(absoluteUri).Split('?', '#')[0].Trim('/').ToLowerInvariant();
        var isAuthRoute = relativePath is "registracija" or "prisijungimas";
        if (isAuthRoute) return;

        var authenticated = await Auth.IsAuthenticatedAsync();
        if (!authenticated)
        {
            NavigationManager.NavigateTo("/prisijungimas", replace: true);
        }
    }

    [Inject]
    private NavigationManager NavigationManager { get; set; } = default!;

    public void Dispose()
    {
        NavigationManager.LocationChanged -= HandleLocationChanged;
    }
}
