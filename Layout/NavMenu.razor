@using nesimokau.lt.Models
@using nesimokau.lt.Services
@inject ProgressService Progress
@inject AuthService Auth
@inject IJSRuntime JS
@inject GameCatalogService Catalog
@inject NavigationManager Navigation
@implements IDisposable

<header class="site-header">
    <a class="brand" href="" aria-label="nesimokau.lt pradžia" @onclick="CloseMobileNavigation">
        <img class="brand-logo" src="images/nesimokau-logo.png" alt="nesimokau.lt" />
        <span class="brand-wordmark">nesimokau<span>.lt</span></span>
    </a>
    <button class="mobile-nav-toggle" type="button" aria-label="@(mobileNavOpen ? "Uždaryti navigaciją" : "Atidaryti navigaciją")" aria-controls="primary-navigation" aria-expanded="@mobileNavOpen" @onclick="ToggleMobileNavigation">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16" /></svg>
    </button>
    <nav id="primary-navigation" class="main-nav @(mobileNavOpen ? "mobile-open" : string.Empty)" aria-label="Pagrindinė navigacija">
        <span class="nav-section-label">MOKYKIS</span>
        <NavLink class="nav-action" href="/" Match="NavLinkMatch.All" @onclick="CloseMobileNavigation">
            <svg class="nav-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="m3.5 10 8.5-7 8.5 7v10a1 1 0 0 1-1 1h-5.3v-6.5h-4.4V21H4.5a1 1 0 0 1-1-1z" /></svg><span>Pradžia</span>
        </NavLink>
        <a class="nav-action nav-subjects" href="/#subjects" @onclick="CloseMobileNavigation">
            <svg class="nav-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 4.5h6a3 3 0 0 1 3 3v12a3 3 0 0 0-3-3H4zM20 4.5h-4a3 3 0 0 0-3 3v12a3 3 0 0 1 3-3h4z" /></svg><span>Dalykai ir žaidimai</span>
        </a>
        <NavLink class="nav-action" href="/dienos-issukis" @onclick="CloseMobileNavigation">
            <svg class="nav-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="m13.5 2.8-8 10.1a1 1 0 0 0 .8 1.6h5l-.8 6.7 8-10.1a1 1 0 0 0-.8-1.6h-5z" /></svg><span>Dienos iššūkis</span>
        </NavLink>
        <button class="nav-action nav-achievements" type="button" @onclick="OpenAchievements">
            <svg class="nav-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M8 4h8v4a4 4 0 0 1-8 0zM8 6H5v2a4 4 0 0 0 4 4m7-6h3v2a4 4 0 0 1-4 4m-3 0v5m-4 4h8m-7-4h6v4H9z" /></svg><span>Pasiekimai</span>
        </button>

        <span class="nav-section-label nav-section-secondary">MANO ERDVĖ</span>
        <NavLink class="nav-action nav-leaderboard" href="/turnyrine-lentele" @onclick="CloseMobileNavigation">
            <svg class="nav-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 19V9m7 10V4m7 15v-7M3 21h18" /></svg><span>Turnyrinė lentelė</span>
        </NavLink>
        <NavLink class="nav-action" href="/rezultatai" @onclick="CloseMobileNavigation">
            <svg class="nav-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 19V5m0 14h17M8 15l4-4 3 2 5-6" /></svg><span>Mano rezultatai</span>
        </NavLink>
        <NavLink class="nav-action" href="/mediateka" @onclick="CloseMobileNavigation">
            <svg class="nav-icon" viewBox="0 0 24 24" aria-hidden="true"><rect x="3.5" y="5" width="17" height="14" rx="2" /><path d="m10 9 5 3-5 3z" /></svg><span>Mediateka</span>
        </NavLink>
        <NavLink class="nav-action nav-settings" href="/profilis" @onclick="CloseMobileNavigation">
            <svg class="nav-icon" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="8" r="3.5" /><path d="M5 20a7 7 0 0 1 14 0" /></svg><span>Profilis ir nustatymai</span>
        </NavLink>

        <div class="sidebar-account">
            <NavLink class="@($"sidebar-account-link avatar-{AvatarBackgroundClass}")" href="/profilis" @onclick="CloseMobileNavigation" aria-label="Atidaryti profilį ir nustatymus">
                @if (!string.IsNullOrWhiteSpace(progress.CustomAvatarDataUrl))
                {
                    <img class="custom-avatar-image" src="@progress.CustomAvatarDataUrl" alt="" />
                }
                else
                {
                    <span class="sidebar-avatar-symbol">@AvatarSymbol</span>
                }
                <span class="sidebar-account-copy"><strong>Mokinio paskyra</strong><small>@CurrentLevel.Number lygis · @progress.Xp XP</small></span>
                <span class="sidebar-account-coins">@progress.Coins <small>mon.</small></span>
            </NavLink>
            <button class="sidebar-tool-button" type="button" @onclick="ToggleTheme" aria-label="Pakeisti temos išvaizdą">
                <svg class="nav-icon" viewBox="0 0 24 24" aria-hidden="true">
                    @if (progress.Theme == "dark")
                    {
                        <path d="M20.5 15.2A8.5 8.5 0 0 1 8.8 3.5a8.6 8.6 0 1 0 11.7 11.7z" />
                    }
                    else
                    {
                        <circle cx="12" cy="12" r="4" /><path d="M12 2v2m0 16v2m10-10h-2M4 12H2m17.1-7.1-1.4 1.4M6.3 17.7l-1.4 1.4m14.2 0-1.4-1.4M6.3 6.3 4.9 4.9" />
                    }
                </svg>
                <span>@(progress.Theme == "light" ? "Tamsi tema" : "Šviesi tema")</span>
            </button>
            <button class="sidebar-tool-button sidebar-logout" type="button" @onclick="LogoutAsync">
                <svg class="nav-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M10 4H5.5a1.5 1.5 0 0 0-1.5 1.5v13A1.5 1.5 0 0 0 5.5 20H10m4-4 4-4-4-4m4 4H9" /></svg><span>Atsijungti</span>
            </button>
        </div>
        <div class="sidebar-note">
            <span class="sidebar-note-mark" aria-hidden="true">01</span>
            <strong>Pažanga prasideda nuo mažo žingsnio.</strong>
            <a href="/#subjects" @onclick="CloseMobileNavigation">Pradėti mokytis <span aria-hidden="true">→</span></a>
        </div>
    </nav>
</header>

@if (achievementToast is not null)
{
    <aside class="achievement-toast" role="status" aria-live="polite">
        <span>@achievementToast.Icon</span>
        <div><small>NAUJAS PASIEKIMAS</small><strong>@achievementToast.Title</strong><p>@achievementToast.Description</p></div>
        <button @onclick="DismissAchievementToast" aria-label="Uždaryti pranešimą">×</button>
    </aside>
}

@if (achievementsOpen)
{
    <div class="level-modal-backdrop" @onclick="CloseAchievements">
        <section class="levels-modal achievements-modal" @onclick:stopPropagation="true" role="dialog" aria-modal="true" aria-labelledby="achievements-title">
            <button class="modal-close" @onclick="CloseAchievements" aria-label="Uždaryti">×</button>
            <p class="eyebrow">TAVO RITMAS</p>
            <h2 id="achievements-title">Pasiekimai ir serija</h2>
            <div class="streak-summary"><span>🔥</span><div><strong>@progress.Streak dienų serija</strong><small>Žaisk bent vieną pratimą kasdien.</small></div></div>
            <div class="streak-calendar" aria-label="Einamo mėnesio aktyvumas">
                @foreach (var day in CurrentMonthDays)
                {
                    <div class="calendar-day @(GamesOn(day) > 0 ? "is-active" : IsMissedDay(day) ? "is-missed" : "")" title="@day.ToString("yyyy-MM-dd"): @GamesOn(day) žaidimų"><small>@day.Day</small><span>🔥</span></div>
                }

            </div>
            <div class="section-heading streak-chart-heading"><div><p class="eyebrow">Paskutinės 10 dienų</p><h3>Atliktų pratimų kreivė</h3></div></div>
            <div class="streak-chart" aria-label="Paskutinių dešimties dienų žaidimų grafikas">
                @foreach (var day in LastTenDays)
                {
                    var count = GamesOn(day);
                    <div class="streak-chart-day"><span style="height:@(Math.Max(8, count * 24))px"></span><small>@day.ToString("dd")</small><b>@count</b></div>
                }
            </div>
            <div class="achievement-grid">
                <div class="achievement-card @(progress.GamesCompleted >= 1 ? "is-earned" : "")"><span>🌱</span><div><strong>Pirmas žingsnis</strong><small>Užbaik pirmą žaidimą</small></div></div>
                <div class="achievement-card @(HasMistake ? "is-earned" : "")"><span>🧩</span><div><strong>Pirma klaida</strong><small>Padaryk pirmą klaidą ir mokykis toliau</small></div></div>
                <div class="achievement-card @(HasPerfectRun(5) ? "is-earned" : "")"><span>✨</span><div><strong>Švarus penketas</strong><small>5 pamokos iš eilės be klaidų</small></div></div>
                <div class="achievement-card @(HasPerfectRun(10) ? "is-earned" : "")"><span>🌟</span><div><strong>Dešimtukas</strong><small>10 pamokų iš eilės be klaidų</small></div></div>
                <div class="achievement-card @(HasPerfectRun(20) ? "is-earned" : "")"><span>💫</span><div><strong>Spindintis kelias</strong><small>20 pamokų iš eilės be klaidų</small></div></div>
                <div class="achievement-card @(HasPerfectRun(50) ? "is-earned" : "")"><span>👑</span><div><strong>Nepralenkiamas</strong><small>50 pamokų iš eilės be klaidų</small></div></div>
                <div class="achievement-card @(progress.Streak >= 7 ? "is-earned" : "")"><span>🔥</span><div><strong>Savaitės ugnelė</strong><small>Išlaikyk 7 dienų seriją</small></div></div>
                <div class="achievement-card @(progress.BestScore >= 500 ? "is-earned" : "")"><span>⭐</span><div><strong>Taškų žvaigždė</strong><small>Surink 500 taškų viename žaidime</small></div></div>
                <div class="achievement-card @(progress.GamesCompleted >= 25 ? "is-earned" : "")"><span>🏅</span><div><strong>Atkaklus mokinys</strong><small>Užbaik 25 žaidimus</small></div></div>
            </div>
        </section>
    </div>
}

@if (practiceOpen)
{
    <div class="level-modal-backdrop" @onclick="ClosePractice">
        <section class="levels-modal practice-modal" @onclick:stopPropagation="true" role="dialog" aria-modal="true" aria-labelledby="practice-title">
            <button class="modal-close" @onclick="ClosePractice" aria-label="Uždaryti">×</button>
            <p class="eyebrow">TIKSLINĖ TRENIRUOTĖ</p>
            <h2 id="practice-title">Pakartok tai, kas buvo sunkiau</h2>
            <p class="modal-subtitle">Pasirink dalyką, o tada pratimą, kuriame anksčiau pasitaikė klaidų.</p>
            <div class="practice-subjects" role="group" aria-label="Pasirink dalyką">
                @foreach (var subject in PracticeSubjects)
                {
                    <button class="filter-chip @(practiceSubject == subject ? "active" : "")" @onclick="() => practiceSubject = subject">@subject</button>
                }
            </div>
            @if (!PracticeTargets.Any())
            {
                <div class="practice-empty"><span>🌟</span><strong>Kol kas nėra ką kartoti</strong><small>Užbaik pratimą, o mažesnio nei 100% tikslumo bandymai atsiras čia.</small></div>
            }
            else
            {
                <div class="practice-targets">
                    @foreach (var target in PracticeTargets)
                    {
                        <NavLink class="practice-target" href="@GameHref(target.Game.Id)" @onclick="ClosePractice">
                            <span class="game-icon icon-@target.Game.Accent">@target.Game.Icon</span>
                            <span><strong>@target.Game.Title</strong><small>@target.Game.Subject · ankstesnis tikslumas @target.Accuracy%</small></span>
                            <b>Pakartoti →</b>
                        </NavLink>
                    }
                </div>
            }
        </section>
    </div>
}

@if (mediaLibraryOpen)
{
    <div class="level-modal-backdrop" @onclick="CloseMediaLibrary">
        <section class="levels-modal media-library-modal" @onclick:stopPropagation="true" role="dialog" aria-modal="true" aria-labelledby="media-library-title">
            <button class="modal-close" @onclick="CloseMediaLibrary" aria-label="Uždaryti">×</button>
            <p class="eyebrow">MOKYMOSI MEDIATEKA</p>
            <h2 id="media-library-title">Vaizdo pamokos</h2>
            <p class="modal-subtitle">Rinkis dalyką arba ieškok temos — nauji įrašai bus pridėti čia.</p>
            <label class="media-search"><span>⌕</span><input @bind="mediaSearch" @bind:event="oninput" placeholder="Ieškoti vaizdo pamokos..." aria-label="Ieškoti vaizdo pamokos" /></label>
            <div class="practice-subjects" role="group" aria-label="Pasirink mediatekos dalyką">
                @foreach (var subject in MediaSubjects)
                {
                    <button class="filter-chip @(mediaSubject == subject ? "active" : "")" @onclick="() => mediaSubject = subject">@subject</button>
                }
            </div>
            <div class="media-library-empty"><span>🎥</span><strong>@(string.IsNullOrWhiteSpace(mediaSearch) ? "Vaizdo pamokos jau pakeliui" : $"„{mediaSearch}“ dar nerasta")</strong><small>@(mediaSubject == "Visi" ? "Pasirink dalyką, kad vėliau matytum jo vaizdo pamokas." : $"{mediaSubject} vaizdo pamokos bus rodomos čia.")</small></div>
        </section>
    </div>
}

@code {
    private StudentProgress progress = new();
    private bool achievementsOpen;
    private bool practiceOpen;
    private bool mediaLibraryOpen;
    private bool mobileNavOpen;
    private string practiceSubject = "Visi";
    private string mediaSubject = "Visi";
    private string mediaSearch = string.Empty;
    private AchievementDefinition? achievementToast;

    private string AvatarSymbol => AvatarCatalog.All.FirstOrDefault(x => x.Id == progress.AvatarId)?.Symbol ?? "🙂";
    private string AvatarBackgroundClass => string.IsNullOrWhiteSpace(progress.AvatarBackground) ? "bg-violet" : progress.AvatarBackground;
    private LevelDefinition CurrentLevel => LevelCatalog.All.Last(level => level.RequiredXp <= progress.Xp);

    protected override async Task OnInitializedAsync()
    {
        progress = await Progress.GetAsync();
        Progress.Changed += HandleProgressChanged;
        await JS.InvokeVoidAsync("nesimokau.setTheme", progress.Theme);
    }

    private void ToggleMobileNavigation()
    {
        mobileNavOpen = !mobileNavOpen;
    }

    private void CloseMobileNavigation() => mobileNavOpen = false;
    private IEnumerable<DateTime> CurrentMonthDays => Enumerable.Range(1, DateTime.DaysInMonth(DateTime.Today.Year, DateTime.Today.Month)).Select(day => new DateTime(DateTime.Today.Year, DateTime.Today.Month, day));
    private IEnumerable<DateTime> LastTenDays => Enumerable.Range(0, 10).Select(day => DateTime.Today.AddDays(-9 + day));
    private IEnumerable<string> PracticeSubjects => ["Visi", .. Catalog.Games.Where(game => game.Status == GameStatus.Ready).Select(game => game.Subject).Distinct()];
    private IEnumerable<string> MediaSubjects => ["Visi", .. Catalog.Games.Select(game => game.Subject).Distinct()];
    private IEnumerable<PracticeTarget> PracticeTargets => Catalog.Games
        .Where(game => game.Status == GameStatus.Ready && (practiceSubject == "Visi" || game.Subject == practiceSubject))
        .Select(game => new { Game = game, Result = progress.RecentResults.Where(result => result.GameId == game.Id).OrderBy(result => result.Accuracy).FirstOrDefault() })
        .Where(item => item.Result is not null && item.Result.Accuracy < 100)
        .Select(item => new PracticeTarget(item.Game, item.Result!.Accuracy));
    private int GamesOn(DateTime day) => progress.RecentResults.Count(result => result.PlayedAt.ToLocalTime().Date == day.Date);
    private bool IsMissedDay(DateTime day) => day.Date < DateTime.Today && GamesOn(day) == 0 && progress.RecentResults.Any(result => result.PlayedAt.ToLocalTime().Date < day.Date);
    private bool HasMistake => progress.RecentResults.Any(result => result.Accuracy < 100);
    private bool HasPerfectRun(int required)
    {
        var run = 0;
        foreach (var result in progress.RecentResults.OrderBy(result => result.PlayedAt))
        {
            run = result.Accuracy == 100 ? run + 1 : 0;
            if (run >= required) return true;
        }

        return false;
    }
    private IEnumerable<AchievementDefinition> EarnedAchievements
    {
        get
        {
            if (progress.GamesCompleted >= 1) yield return new("first-step", "🌱", "Pirmas žingsnis", "Užbaigei pirmą žaidimą.");
            if (HasMistake) yield return new("first-mistake", "🧩", "Pirma klaida", "Klaidos padeda išmokti dar daugiau.");
            if (HasPerfectRun(5)) yield return new("perfect-5", "✨", "Švarus penketas", "5 pamokos iš eilės be klaidų.");
            if (HasPerfectRun(10)) yield return new("perfect-10", "🌟", "Dešimtukas", "10 pamokų iš eilės be klaidų.");
            if (HasPerfectRun(20)) yield return new("perfect-20", "💫", "Spindintis kelias", "20 pamokų iš eilės be klaidų.");
            if (HasPerfectRun(50)) yield return new("perfect-50", "👑", "Nepralenkiamas", "50 pamokų iš eilės be klaidų.");
            if (progress.Streak >= 7) yield return new("streak-7", "🔥", "Savaitės ugnelė", "Išlaikei 7 dienų seriją.");
            if (progress.BestScore >= 500) yield return new("score-500", "⭐", "Taškų žvaigždė", "Viename žaidime surinkai 500 taškų.");
            if (progress.GamesCompleted >= 25) yield return new("games-25", "🏅", "Atkaklus mokinys", "Užbaigei 25 žaidimus.");
        }
    }
    private static string GameHref(string gameId) => gameId switch
    {
        "dictation" => "zaidimai/zodziu-diktantas",
        "missing-letters" => "zaidimai/praleistos-raides",
        _ => "/"
    };
    private void OpenAchievements()
    {
        CloseMobileNavigation();
        achievementsOpen = true;
    }
    private void CloseAchievements() => achievementsOpen = false;
    private void OpenPractice()
    {
        practiceSubject = "Visi";
        practiceOpen = true;
    }
    private void ClosePractice() => practiceOpen = false;
    private void OpenMediaLibrary()
    {
        mediaSubject = "Visi";
        mediaSearch = string.Empty;
        mediaLibraryOpen = true;
    }
    private void CloseMediaLibrary() => mediaLibraryOpen = false;
    private void DismissAchievementToast() => achievementToast = null;

    private async Task LogoutAsync()
    {
        await Auth.LogoutAsync();
        CloseMobileNavigation();
        Navigation.NavigateTo("/prisijungimas", replace: true);
    }

    private async Task ToggleTheme()
    {
        var theme = progress.Theme == "dark" ? "light" : "dark";
        progress.Theme = theme;
        await JS.InvokeVoidAsync("nesimokau.setTheme", theme);
        await Progress.SaveThemeAsync(theme);
    }

    private void HandleProgressChanged() => _ = InvokeAsync(async () =>
    {
        progress = await Progress.GetAsync();
        var earned = EarnedAchievements.ToList();
        var newIds = await Progress.UnlockAchievementsAsync(earned.Select(achievement => achievement.Id));
        var newest = earned.FirstOrDefault(achievement => newIds.Contains(achievement.Id));
        if (newest is not null)
        {
            achievementToast = newest;
            StateHasChanged();
            await Task.Delay(5500);
            if (achievementToast?.Id == newest.Id) achievementToast = null;
        }
        StateHasChanged();
    });

    public void Dispose() => Progress.Changed -= HandleProgressChanged;

    private sealed record PracticeTarget(GameDefinition Game, int Accuracy);
    private sealed record AchievementDefinition(string Id, string Icon, string Title, string Description);
}
