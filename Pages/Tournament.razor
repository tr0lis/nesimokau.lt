@page "/turnyrine-lentele"
@using nesimokau.lt.Models
@using nesimokau.lt.Services
@inject LeaderboardService Leaderboard
@inject IJSRuntime JS
@implements IDisposable

<SeoHead Title="Turnyrinė lentelė – geriausi žaidėjai | nesimokau.lt" Description="Geriausių nesimokau.lt žaidėjų turnyrinė lentelė: visų laikų, šio mėnesio ir šios savaitės rezultatai." />

<section class="lb-page">
    <div class="lb-glow" aria-hidden="true"></div>
    <header class="lb-head">
        <div>
            <p class="lb-label">TURNYRINĖ LENTELĖ</p>
            <h1>Geriausi žaidėjai Lietuvoje</h1>
            <p class="lb-live"><span class="lb-dot" aria-hidden="true"></span>Atnaujinama realiu laiku</p>
        </div>
        <div class="lb-tabs" role="tablist" aria-label="Laikotarpis">
            @foreach (var tab in Periods)
            {
                <button type="button" role="tab" class="lb-tab @(period == tab.Key ? "is-active" : "")" aria-selected="@(period == tab.Key ? "true" : "false")" @onclick="() => SetPeriodAsync(tab.Key)">@tab.Label</button>
            }
        </div>
    </header>

    @if (isLoading)
    {
        <div class="loading-state loading-skeleton" role="status" aria-label="Kraunama"><span class="sk sk-title"></span><span class="sk sk-line"></span><div class="sk-grid"><span class="sk sk-card"></span><span class="sk sk-card"></span><span class="sk sk-card"></span></div></div>
    }
    else if (!entries.Any())
    {
        <section class="lb-card">
            <div class="lb-card-head"><h2>Top 20</h2><span>Dar nėra rezultatų</span></div>
            <p class="lb-empty">Kol kas tuščia. Užbaik užduotis ir būk pirmas.</p>
        </section>
    }
    else
    {
        <section class="lb-card">
            <div class="lb-card-head"><h2>Top 20</h2><span>Rikiuojama pagal taškus</span></div>
            <ol class="lb-list">
                @foreach (var row in ListRows)
                {
                    <li class="lb-row @(row.Entry.Id == currentPlayerId ? "is-self" : "")" style="--i:@row.Index">
                        <span class="lb-rank">@row.Place</span>
                        <span class="lb-avatar @AvatarBgClassFor(row.Entry)">@row.Entry.Avatar</span>
                        <div class="lb-who">
                            <strong>@row.Entry.Name <span class="player-flag">@row.Entry.CountryFlag</span></strong>
                            <span class="lb-bar"><i style="width:@Pct(row.Entry.Score)%"></i></span>
                        </div>
                        <b class="lb-score">@Fmt(row.Entry.Score)</b>
                    </li>
                }
            </ol>
            @if (CurrentUserEntry is not null && CurrentUserIndex >= 20)
            {
                <div class="lb-me">
                    <span class="lb-rank">@(CurrentUserIndex + 1)</span>
                    <span class="lb-avatar @AvatarBgClassFor(CurrentUserEntry)">@CurrentUserEntry.Avatar</span>
                    <div class="lb-who">
                        <strong>Tavo vieta · @CurrentUserEntry.Name</strong>
                        <small>@GapText</small>
                    </div>
                    <b class="lb-score">@Fmt(CurrentUserEntry.Score)</b>
                </div>
            }
        </section>
    }
</section>
@code {
    private List<LeaderboardEntry> entries = [];
    private string currentPlayerId = string.Empty;
    private bool isLoading = true;
    private PeriodicTimer? timer;
    private CancellationTokenSource? cts;

    private IEnumerable<(int Place, int Index, LeaderboardEntry Entry)> ListRows => entries.Take(20).Select((entry, index) => (index + 1, index, entry));
    private int CurrentUserIndex => entries.FindIndex(entry => entry.Id == currentPlayerId);
    private LeaderboardEntry? CurrentUserEntry => string.IsNullOrEmpty(currentPlayerId) ? null : entries.FirstOrDefault(entry => entry.Id == currentPlayerId);
    private string GapText => CurrentUserIndex <= 0 ? "Tu pirmauji – taip ir toliau!" : $"Iki kitos vietos trūksta {Fmt(Math.Max(1, entries[CurrentUserIndex - 1].Score - CurrentUserEntry!.Score + 1))} taškų";
    private double Pct(int score) => entries.Count == 0 || entries[0].Score <= 0 ? 0 : Math.Clamp(score * 100.0 / entries[0].Score, 0, 100);
    private static string Fmt(int value) => value.ToString("N0", System.Globalization.CultureInfo.InvariantCulture).Replace(",", "\u00A0");

    private string period = "all";
    private static readonly (string Key, string Label)[] Periods = [("all", "Visi laikai"), ("month", "Šis mėnuo"), ("week", "Ši savaitė")];
    private bool animated;
    private int loadVersion;

    private async Task SetPeriodAsync(string value)
    {
        if (period == value) return;
        period = value;
        animated = false;
        isLoading = true;
        var version = ++loadVersion;
        await LoadEntriesAsync(version);
    }

    private async Task LoadEntriesAsync(int version)
    {
        var result = (await Leaderboard.GetEntriesAsync(period)).ToList();
        if (version != loadVersion) return;
        entries = result;
        isLoading = false;
        await InvokeAsync(StateHasChanged);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!animated && !isLoading && entries.Count > 0)
        {
            animated = true;
            try { await JS.InvokeVoidAsync("nesimokau.countUp"); } catch (JSException) { }
        }
    }
    private string AvatarBgClassFor(LeaderboardEntry? entry)
    {
        if (entry is null) return "avatar-bg-violet";
        return ToAvatarBgClass(entry.AvatarBackground);
    }

    protected override async Task OnInitializedAsync()
    {
        currentPlayerId = await Leaderboard.GetCurrentPlayerIdAsync();
        entries = (await Leaderboard.GetEntriesAsync(period)).ToList();
        isLoading = false;

        cts = new CancellationTokenSource();
        timer = new PeriodicTimer(TimeSpan.FromSeconds(5));
        _ = Task.Run(async () =>
        {
            while (timer is not null && await timer.WaitForNextTickAsync(cts.Token))
            {
                var refreshPeriod = period;
                var result = (await Leaderboard.RefreshRealtimeAsync(refreshPeriod)).ToList();
                if (period != refreshPeriod) continue;
                entries = result;
                await InvokeAsync(StateHasChanged);
            }
        }, cts.Token);
    }

    private static string ToAvatarBgClass(string? value)
    {
        if (string.IsNullOrWhiteSpace(value)) return "avatar-bg-violet";
        if (value.StartsWith("avatar-bg-", StringComparison.Ordinal)) return value;
        if (value.StartsWith("bg-", StringComparison.Ordinal)) return $"avatar-{value}";
        return $"avatar-bg-{value}";
    }

    public void Dispose()
    {
        cts?.Cancel();
        timer?.Dispose();
        cts?.Dispose();
    }
}
