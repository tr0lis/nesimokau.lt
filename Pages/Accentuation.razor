@page "/zaidimai/kirciavimas"
@page "/lietuviu-kalba/{ClassSlug}/kirciavimas"
@implements IDisposable
@using System.Globalization
@using System.Text
@using Microsoft.AspNetCore.Components
@using nesimokau.lt.Models
@using nesimokau.lt.Services
@inject HttpClient Http
@inject ProgressService Progress
@inject ActivityLogService ActivityLog
@inject NavigationManager Navigation
@inject IJSRuntime JS

<PageTitle>Kirčiavimo pratimas | nesimokau.lt</PageTitle>

@if (loading)
{
    <div class="loading-state"><span class="loader"></span><p>Ruošiame kirčiavimo pratimą...</p></div>
}
else if (!started)
{
    <section class="difficulty-screen">
        <button class="button button-ghost prestart-back" @onclick="GoBackToSubject">← Atgal</button>
        <p class="eyebrow">PASIRINK SUNKUMĄ</p>
        <h1>Kirčiavimo pratimas</h1>
        <p class="subtitle">Nuvilk kirtį ant teisingos raidės.</p>
        <div class="difficulty-options">
            @foreach (var option in difficultyOptions)
            {
                <button class="difficulty-option @(selectedDifficulty == option.Key ? "selected" : "")" @onclick="() => selectedDifficulty = option.Key"><span>@option.Icon</span><strong>@option.Title</strong><small>@option.Hint</small></button>
            }
        </div>
        <button class="button button-primary" @onclick="StartGame">Pradėti <span>→</span></button>
    </section>
}
else if (finished)
{
    <section class="result-screen">
        <div class="result-burst">ˈ</div><p class="eyebrow">Pratimas baigtas!</p><h1>Kirčiuoji vis tiksliau<span class="gradient-text">!</span></h1>
        <p class="subtitle">Kuo daugiau praktikos, tuo užtikrintesnė tartis ir rašyba.</p>
        <div class="result-score"><strong>@score</strong><span>taškai</span></div>
        <div class="result-stats"><div><strong>@Accuracy%</strong><span>Tikslumas</span></div><div><strong>⚡ +@earnedXp</strong><span>Uždirbta energija</span></div><div><strong>🪙 +@earnedCoins</strong><span>Uždirbtos monetos</span></div></div>
        <div class="result-actions"><button class="button button-primary" @onclick="Restart">Žaisti dar kartą <span>↗</span></button><button class="button button-ghost" @onclick="GoHome">Grįžti į pradžią</button></div>
    </section>
}
else if (current is not null)
{
    <NavigationLock OnBeforeInternalNavigation="ConfirmLeave" ConfirmExternalNavigation="true" />
    <div class="game-header"><button class="back-button" @onclick="GoHome" aria-label="Grįžti">←</button><div class="game-title"><span class="game-icon icon-violet">ˈ</span><div><p class="eyebrow">LIETUVIŲ KALBA</p><h1>Kirčiavimas</h1></div></div></div>
    <div class="game-progress"><div><span>@(@index + 1) / @questions.Count</span><span>@score taškai</span></div><div class="progress-track"><span style="width:@ProgressPercent%"></span></div></div>

    <section class="game-panel accentuation-panel">
        <div class="tip-card tip-card-inline"><span>✦</span><div><strong>Užduotis</strong><p>Paspausk raidę ir pasirink kirčio ženklą.</p></div></div>

        <div class="accentuation-board">
            <div class="accent-word-wrap">
                @if (feedback is null && openAccentMenuIndex is not null)
                {
                    <div class="accent-inline-picker" role="menu">
                        @foreach (var accent in accentOptions)
                        {
                            <button type="button" class="accent-choice" role="menuitem" aria-label="@accent.Title" @onclick="() => PlaceAccent(openAccentMenuIndex.Value, accent.Key, accent.Symbol)">@accent.Symbol</button>
                        }
                    </div>
                }
                <div class="accent-letter-row">
                    @for (var i = 0; i < current.Word.Length; i++)
                    {
                        <button type="button"
                                class="accent-letter accent-letter-button @SlotFeedbackClass(i) @(placedAccentIndex == i ? "is-filled" : string.Empty) @(openAccentMenuIndex == i ? "is-open" : string.Empty)"
                                @onclick="() => ToggleAccentMenu(i)"
                                disabled="@(feedback is not null)"
                                aria-label="@SlotAriaLabel(i)">
                            <span class="accent-letter-accent">@DisplayedAccentText(i)</span>
                            <span class="accent-letter-char">@current.Word[i]</span>
                        </button>
                    }
                </div>
            </div>

        @if (feedback is null && placedAccentIndex is not null)
        {
            <button type="button" class="accent-clear-inline" @onclick="ClearDrop">↺ Išvalyti pasirinktą kirtį</button>
        }
        </div>

        @if (feedback is not null)
        {
            <div class="feedback @(isCorrect ? "feedback-good" : "feedback-bad")"><strong>@(isCorrect ? "Teisingai!" : "Dar kartą pagalvok")</strong><span>@feedback</span></div>
            <button class="button button-primary next-button" @onclick="Next">@(isLast ? "Pamatyti rezultatą" : "Kitas žodis") <span>→</span></button>
        }
        else
        {
            <button class="button button-primary submit-button" @onclick="Submit" disabled="@(placedAccentIndex is null || string.IsNullOrWhiteSpace(placedAccentType))">Patikrinti <span>↗</span></button>
        }
    </section>
}

@code {
    private readonly (string Key, string Title, string Hint, string Icon)[] difficultyOptions =
    [
        ("Lengvas", "Lengvas", "Paprasti žodžiai", "ˈ"),
        ("Vidutinis", "Vidutinis", "Dažnesnės išimtys", "ˈˈ"),
        ("Sudėtingas", "Sudėtingas", "Sudėtingesni atvejai", "ˈˈˈ")
    ];

    private readonly (string Key, string Title, string Symbol)[] accentOptions =
    [
        ("kairinis", "Kairinis kirtis", "`"),
        ("dešininis", "Dešininis kirtis", "´"),
        ("riestinis", "Riestinis kirtis", "~")
    ];

    private List<AccentuationWord> allWords = [];
    private List<AccentuationWord> questions = [];
    private AccentuationWord? current;
    private bool loading = true;
    private bool started;
    private bool finished;
    private int index;
    private int score;
    private int wrongAnswers;
    private int earnedXp;
    private int earnedCoins;
    private string selectedDifficulty = "Lengvas";
    private string? feedback;
    private bool isCorrect;
    private int? placedAccentIndex;
    private string? placedAccentType;
    private string? placedAccentSymbol;
    private int? openAccentMenuIndex;
    private (int Index, string Type)? expectedAccent;
    private bool showExpectedAccent;
    private CancellationTokenSource? feedbackAnimationCancellation;
    private HashSet<int> sessionSolvedQuestionIds = [];
    private bool isLast => index == questions.Count - 1;
    private int ProgressPercent => questions.Count == 0 ? 0 : (index + 1) * 100 / questions.Count;
    private int Accuracy => questions.Count == 0 ? 0 : Math.Max(0, (questions.Count - wrongAnswers) * 100 / questions.Count);

    [Parameter] public string? ClassSlug { get; set; }
    [SupplyParameterFromQuery(Name = "level")] public string? LevelSlug { get; set; }

    protected override async Task OnInitializedAsync()
    {
        var source = await Http.GetFromJsonAsync<List<AccentuationWord>>("data/accentuation.json") ?? [];
        allWords = source;
        selectedDifficulty = ResolveDifficultyFromLevel(LevelSlug);
        loading = false;
    }

    private async Task StartGame()
    {
        var solvedQuestionIds = (await Progress.GetSolvedQuestionIdsAsync("accentuation")).ToHashSet();
        var pool = allWords.Where(x => string.Equals(x.Difficulty, selectedDifficulty, StringComparison.OrdinalIgnoreCase)).ToList();
        if (pool.Count == 0) pool = allWords;

        var unsolved = pool.Where(x => !solvedQuestionIds.Contains(x.Id)).OrderBy(_ => Random.Shared.Next()).ToList();
        questions = (unsolved.Count > 0 ? unsolved : pool).OrderBy(_ => Random.Shared.Next()).Take(10).ToList();

        sessionSolvedQuestionIds = [];
        index = 0;
        score = 0;
        wrongAnswers = 0;
        feedback = null;
        placedAccentIndex = null;
        placedAccentType = null;
        placedAccentSymbol = null;
        openAccentMenuIndex = null;
        expectedAccent = null;
        showExpectedAccent = false;
        current = questions.FirstOrDefault();
        started = current is not null;

        if (started)
        {
            await ActivityLog.LogAsync("exercise_started", evt =>
            {
                evt.Subject = "Lietuvių kalba";
                evt.GameId = "accentuation";
                evt.GameTitle = "Kirčiavimo pratimas";
                evt.Payload["taskCount"] = questions.Count;
                evt.Payload["difficulty"] = selectedDifficulty;
            });
        }
    }

    private void ToggleAccentMenu(int index)
    {
        if (feedback is not null) return;
        openAccentMenuIndex = openAccentMenuIndex == index ? null : index;
    }

    private void PlaceAccent(int index, string accentType, string accentSymbol)
    {
        if (feedback is not null) return;
        placedAccentIndex = index;
        placedAccentType = accentType;
        placedAccentSymbol = accentSymbol;
        openAccentMenuIndex = null;
    }

    private void ClearDrop()
    {
        if (feedback is not null) return;
        placedAccentIndex = null;
        placedAccentType = null;
        placedAccentSymbol = null;
        openAccentMenuIndex = null;
    }

    private async Task Submit()
    {
        if (current is null || feedback is not null || placedAccentIndex is null || string.IsNullOrWhiteSpace(placedAccentType)) return;

        var expected = ParseExpectedAccent(current.Word, current.AccentedWord);
        expectedAccent = expected;

        isCorrect = placedAccentIndex.Value == expected.Index
            && string.Equals(placedAccentType, expected.Type, StringComparison.OrdinalIgnoreCase);

        if (isCorrect)
        {
            score += PointsForDifficulty(current.Difficulty);
            sessionSolvedQuestionIds.Add(current.Id);
            feedback = "Teisingai pažymėjai kirčio vietą ir tipą.";
        }
        else
        {
            wrongAnswers++;
            feedback = $"Teisinga vieta: {expected.Index + 1} raidė, kirtis: {AccentSymbol(expected.Type)}. {current.Explanation}";

            if (placedAccentIndex == expected.Index)
            {
                StartFeedbackAnimation();
            }
        }

        await ActivityLog.LogAsync("answer_submitted", evt =>
        {
            evt.Subject = "Lietuvių kalba";
            evt.GameId = "accentuation";
            evt.GameTitle = "Kirčiavimo pratimas";
            evt.IsCorrect = isCorrect;
            evt.QuestionId = current.Id.ToString();
            evt.MistakeType = isCorrect ? null : "accentuation";
            evt.Payload["word"] = current.Word;
            evt.Payload["expectedIndex"] = expected.Index;
            evt.Payload["expectedType"] = expected.Type;
            evt.Payload["placedIndex"] = placedAccentIndex;
            evt.Payload["placedType"] = placedAccentType;
        });
    }

    private async Task Next()
    {
        StopFeedbackAnimation();

        if (isLast)
        {
            finished = true;
            var totalQuestions = allWords.Count;
            var savedProgress = await Progress.GetAsync();
            var alreadyCompleted = totalQuestions > 0 && savedProgress.SolvedQuestionIdsByGame.GetValueOrDefault("accentuation")?.Distinct().Count() >= totalQuestions;
            var persistedScore = alreadyCompleted ? 0 : score;
            earnedXp = alreadyCompleted ? 0 : score / 10;
            earnedCoins = alreadyCompleted ? 0 : score / 50 + (Accuracy == 100 ? 2 : 0);

            await Progress.SaveResultAsync(new GameResult("accentuation", "Kirčiavimo pratimas", persistedScore, Accuracy, earnedXp, earnedCoins, DateTime.Now)
            {
                ClassGroup = savedProgress.ClassGroup,
                CorrectAnswers = questions.Count - wrongAnswers,
                IncorrectAnswers = wrongAnswers
            });

            if (Accuracy == 100) await Progress.ClearPracticeTargetAsync("accentuation");
            else await Progress.SavePracticeTargetAsync("accentuation", wrongAnswers);
            await Progress.SaveSolvedQuestionIdsAsync("accentuation", sessionSolvedQuestionIds);
            return;
        }

        index++;
        current = questions[index];
        feedback = null;
        isCorrect = false;
        placedAccentIndex = null;
        placedAccentType = null;
        placedAccentSymbol = null;
        openAccentMenuIndex = null;
        expectedAccent = null;
        showExpectedAccent = false;
    }

    private static int PointsForDifficulty(string difficulty)
        => difficulty switch
        {
            "Lengvas" => 50,
            "Vidutinis" => 75,
            _ => 100
        };

    private string? SlotAccentType(int slotIndex)
    {
        if (feedback is not null && expectedAccent is { } expected)
        {
            if (isCorrect && slotIndex == expected.Index)
            {
                return expected.Type;
            }

            if (!isCorrect && placedAccentIndex == expected.Index && slotIndex == expected.Index)
            {
                return showExpectedAccent ? expected.Type : placedAccentType;
            }

            if (!isCorrect && slotIndex == expected.Index)
            {
                return expected.Type;
            }
        }

        return placedAccentIndex == slotIndex ? placedAccentType : null;
    }

    private string SlotAriaLabel(int slotIndex)
    {
        var type = SlotAccentType(slotIndex);
        return string.IsNullOrEmpty(type) ? $"Raidė {slotIndex + 1}" : $"Raidė {slotIndex + 1}, {AccentSymbol(type)}";
    }

    private string DisplayedAccentText(int slotIndex)
    {
        if (feedback is null)
        {
            return placedAccentIndex == slotIndex ? placedAccentSymbol ?? string.Empty : string.Empty;
        }

        return AccentSymbol(SlotAccentType(slotIndex));
    }

    private string SlotFeedbackClass(int slotIndex)
    {
        if (feedback is null || expectedAccent is not { } expected) return string.Empty;
        if (isCorrect) return slotIndex == expected.Index ? "is-correct" : string.Empty;

        if (placedAccentIndex == expected.Index && slotIndex == expected.Index)
        {
            return showExpectedAccent ? "is-correct" : "is-incorrect";
        }

        if (slotIndex == expected.Index) return "is-correct";
        return slotIndex == placedAccentIndex ? "is-incorrect" : string.Empty;
    }

    private void StartFeedbackAnimation()
    {
        StopFeedbackAnimation();
        feedbackAnimationCancellation = new CancellationTokenSource();
        _ = AnimateFeedbackAsync(feedbackAnimationCancellation.Token);
    }

    private async Task AnimateFeedbackAsync(CancellationToken cancellationToken)
    {
        try
        {
            while (!cancellationToken.IsCancellationRequested)
            {
                await Task.Delay(TimeSpan.FromSeconds(2), cancellationToken);
                showExpectedAccent = !showExpectedAccent;
                await InvokeAsync(StateHasChanged);
            }
        }
        catch (OperationCanceledException)
        {
        }
    }

    private void StopFeedbackAnimation()
    {
        feedbackAnimationCancellation?.Cancel();
        feedbackAnimationCancellation?.Dispose();
        feedbackAnimationCancellation = null;
    }

    private string AccentSymbol(string? accentType)
        => accentType switch
        {
            "kairinis" => "`",
            "dešininis" => "´",
            "riestinis" => "~",
            _ => string.Empty
        };

    private static (int Index, string Type) ParseExpectedAccent(string plainWord, string accentedWord)
    {
        if (string.IsNullOrWhiteSpace(plainWord) || string.IsNullOrWhiteSpace(accentedWord))
        {
            return (0, "dešininis");
        }

        var normalized = accentedWord.Normalize(NormalizationForm.FormD);
        var letterIndex = -1;

        foreach (var ch in normalized)
        {
            var category = CharUnicodeInfo.GetUnicodeCategory(ch);

            if (char.IsLetter(ch))
            {
                letterIndex++;
                continue;
            }

            if (category == UnicodeCategory.NonSpacingMark)
            {
                var type = ch switch
                {
                    '\u0300' => "kairinis",
                    '\u0301' => "dešininis",
                    '\u0303' => "riestinis",
                    _ => null
                };

                if (type is not null)
                {
                    return (Math.Clamp(letterIndex, 0, plainWord.Length - 1), type);
                }

                continue;
            }
        }

        return (0, "dešininis");
    }

    private void Restart() => Navigation.NavigateTo(RouteBase(), true);
    private void GoHome() => Navigation.NavigateTo(ClassSlug is null ? "/" : "/lietuviu-kalba");
    private void GoBackToSubject() => Navigation.NavigateTo("/lietuviu-kalba");
    private string RouteBase() => ClassSlug is null ? "zaidimai/kirciavimas" : $"lietuviu-kalba/{ClassSlug}/kirciavimas";
    private static string ResolveDifficultyFromLevel(string? level)
        => level?.Trim().ToLowerInvariant() switch
        {
            "a1-a2" => "Lengvas",
            "b1-b2" => "Vidutinis",
            "c1-c2" => "Sudėtingas",
            _ => "Lengvas"
        };

    private async Task ConfirmLeave(LocationChangingContext context)
    {
        if (!finished && !await JS.InvokeAsync<bool>("confirm", "Ar tikrai nori išeiti? Rezultatai nebus įskaityti."))
        {
            context.PreventNavigation();
        }
    }

    public void Dispose() => StopFeedbackAnimation();
}
