@page "/"
@using nesimokau.lt.Models
@using nesimokau.lt.Services
@inject ProgressService Progress
@implements IDisposable

<PageTitle>Nemokami mokomieji žaidimai vaikams | nesimokau.lt</PageTitle>

<section class="subjects-home">
    <div class="dashboard-head">
        <div>
            <p class="eyebrow">Mokymasis žaidžiant <span class="spark">✦</span></p>
            <h1>Pasirink dalyką</h1>
            <p class="subtitle">Pagrindiniame puslapyje rodomi tik dalykai. Pratimai atsidaro pasirinkto dalyko lange.</p>
        </div>
        <button class="level-card level-card-@CurrentLevel.Color" @onclick="() => showLevels = true" title="Peržiūrėti lygius">
            <div class="level-top"><span class="level-label">LYGIS @CurrentLevel.Number</span><strong>⚡ @progress.Xp Energija</strong></div>
            <div class="level-identity"><span class="level-badge badge-@CurrentLevel.Color">@CurrentLevel.Badge</span><strong>@CurrentLevel.Title</strong></div>
            <div class="level-bar"><span style="width:@LevelProgress%"></span></div>
            <small>@(NextLevel is null ? "Pasiektas aukščiausias lygis" : $"{NextLevel.RequiredXp - progress.Xp} Energijos iki kito lygio")</small>
        </button>
    </div>

    @if (showLevels)
    {
        <div class="level-modal-backdrop" @onclick="() => showLevels = false">
            <section class="levels-modal" @onclick:stopPropagation="true" role="dialog" aria-modal="true" aria-labelledby="levels-title">
                <button class="modal-close" @onclick="() => showLevels = false" aria-label="Uždaryti">×</button>
                <p class="eyebrow">TAVO KELIAS</p><h2 id="levels-title">Lygių ženkliukai</h2><p class="modal-subtitle">Rink energiją ir kopk vis aukščiau.</p>
                <div class="levels-list">
                    @foreach (var level in LevelCatalog.All)
                    {
                        <div class="level-row @(level.Number == CurrentLevel.Number ? "current" : "")"><span class="level-badge badge-@level.Color">@level.Badge</span><div><strong>@level.Number. @level.Title</strong><small>⚡ @level.RequiredXp Energija</small></div>@if (level.Number == CurrentLevel.Number) { <span class="level-current">DABAR</span> }</div>
                    }
                </div>
            </section>
        </div>
    }

    <div class="subjects-grid">
        @foreach (var subject in SubjectCards)
        {
            <NavLink class="@SubjectCardClass(subject)" href="@subject.Href">
                <span class="subject-card-icon icon-@subject.Accent">@subject.Icon</span>
                <span class="subject-card-copy">
                    <strong>@subject.Title</strong>
                    <small>@subject.Description</small>
                </span>
                @if (subject.IsReady)
                {
                    <span class="subject-card-corner" aria-hidden="true">↗</span>
                }
                else
                {
                    <span class="subject-card-corner subject-card-corner-disabled">Netrukus</span>
                }
            </NavLink>
        }
    </div>
</section>

@code {
    private StudentProgress progress = new();
    private bool showLevels;
    private LevelDefinition CurrentLevel => LevelCatalog.All.Last(level => level.RequiredXp <= progress.Xp);
    private LevelDefinition? NextLevel => LevelCatalog.All.FirstOrDefault(level => level.RequiredXp > progress.Xp);
    private int LevelProgress => NextLevel is null ? 100 : Math.Clamp((progress.Xp - CurrentLevel.RequiredXp) * 100 / (NextLevel.RequiredXp - CurrentLevel.RequiredXp), 5, 100);
    private static IReadOnlyList<SubjectCard> SubjectCards { get; } =
    [
        new("Lietuvių kalba", "Aa", "violet", "Rašybos ir kalbos pratimai pagal klases.", "/lietuviu-kalba", true),
        new("Matematika", "∑", "blue", "Skaičiavimo ir logikos užduotys.", "/", false),
        new("Anglų kalba", "EN", "mint", "Vocabulary ir grammar praktika.", "/", false),
        new("Istorija", "◷", "orange", "Istorinių žinių užduotys.", "/", false),
        new("Gamtos mokslai", "✦", "cyan", "Moksliniai eksperimentai ir testai.", "/", false)
    ];

    protected override async Task OnInitializedAsync()
    {
        progress = await Progress.GetAsync();
        Progress.Changed += HandleProgressChanged;
    }

    private void HandleProgressChanged() => _ = InvokeAsync(async () =>
    {
        progress = await Progress.GetAsync();
        StateHasChanged();
    });

    public void Dispose() => Progress.Changed -= HandleProgressChanged;

    private static string SubjectCardClass(SubjectCard subject) => subject.IsReady ? "subject-card" : "subject-card is-disabled";

    private sealed record SubjectCard(string Title, string Icon, string Accent, string Description, string Href, bool IsReady);
}
