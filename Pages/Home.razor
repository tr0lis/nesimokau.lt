@page "/"
@using nesimokau.lt.Models
@using nesimokau.lt.Services
@inject ProgressService Progress
@inject GameCatalogService Catalog
@inject AuthService AuthSvc
@implements IDisposable

<SeoHead Title="@(signedIn ? "Pradžia" : "nesimokau.lt – Mokykis žaisdamas!")"
         Description="Mokomieji žaidimai 1–12 klasių mokiniams. Edukaciniai žaidimai vaikams pagal mokomuosius dalykus. Tobulėk lengviau!"
         CanonicalPath="/"
         Indexable="true" />

<section class="subjects-home dashboard-home">
    <section class="home-hero">
        <div class="home-hero-copy">
            <span class="home-greeting">MOKYKIS SAVO TEMPU</span>
            <h1>Mokykis <span>žaisdamas!</span></h1>
            <p>Mokomieji žaidimai ir užduotys 1-12 klasių mokiniams. Rinkis dalyką ir tapk tikru jo asu!</p>
        </div>
        <div class="home-hero-art" aria-hidden="true">
            <span class="hero-orbit hero-orbit-one"></span>
            <span class="hero-orbit hero-orbit-two"></span>
            <img src="/images/nesimokau-logo.png" alt="" />
        </div>
        <button class="home-level-card level-color-@CurrentLevel.Color" type="button" @onclick="() => showLevels = true" aria-label="Peržiūrėti lygius">
            <span class="home-level-icon badge-@CurrentLevel.Color">@CurrentLevel.Badge</span>
            <span class="home-level-copy">
                <strong>@CurrentLevel.Number lygis</strong>
                <small>@(NextLevel is null ? "Pasiektas aukščiausias lygis!" : $"Dar {NextLevel.RequiredXp - progress.Xp} XP iki kito lygio")</small>
            </span>
            <span class="home-level-arrow" aria-hidden="true">↗</span>
            <span class="home-level-progress"><i style="width:@LevelProgress%"></i></span>
            <strong class="home-level-xp">@progress.Xp XP</strong>
            <span class="home-level-streak"><FlameIcon /> @progress.Streak dienų iš eilės <span aria-hidden="true">▦</span></span>
        </button>
    </section>

    @if (showLevels)
    {
        <div class="level-modal-backdrop" @onclick="() => showLevels = false">
            <section class="levels-modal" @onclick:stopPropagation="true" role="dialog" aria-modal="true" aria-labelledby="levels-title">
                <button class="modal-close" @onclick="() => showLevels = false" aria-label="Uždaryti">×</button>
                <p class="eyebrow">TAVO KELIAS</p><h2 id="levels-title">Lygių ženkliukai</h2><p class="modal-subtitle">Rink energiją ir kopk vis aukščiau.</p>
                <div class="levels-list">
                    @foreach (var level in LevelCatalog.All)
                    {
                        <div class="level-row lvl-@level.Number level-color-@level.Color @(level.Number == CurrentLevel.Number ? "current" : "")"><span class="level-badge badge-@level.Color">@level.Badge</span><div><strong>@level.Number. @level.Title</strong><small><EnergyIcon /> @level.RequiredXp XP</small>@if (NextLevel is not null && level.Number == NextLevel.Number) { <em class="level-missing">Trūksta @(Math.Max(0, level.RequiredXp - progress.Xp)) XP</em> }</div>@if (level.Number == CurrentLevel.Number) { <span class="level-current">DABAR</span> }</div>
                    }
                </div>
            </section>
        </div>
    }

    <section class="home-subjects" id="subjects">
        <div class="home-section-heading">
            <div><span class="home-heading-mark"></span><h2>Pasirink dalyką</h2></div>
            <a href="#subjects">Visi dalykai <span aria-hidden="true">→</span></a>
        </div>
        <div class="subjects-grid home-subject-grid">
        @foreach (var subject in SubjectCards)
        {
            @if (subject.IsReady)
            {
                <NavLink class="@($"subject-card home-subject-card accent-{subject.Accent}")" href="@subject.Href">
                    <span class="subject-card-icon icon-@subject.Accent" aria-hidden="true"><GameIcon Key="@subject.Title" /></span>
                    <span class="subject-card-copy">
                        <strong>@subject.Title</strong>
                        <small>@subject.Description</small>
                        <span class="home-subject-count">@subject.ActivityCount @ActivityLabel(subject.ActivityCount)</span>
                    </span>
                    <span class="subject-card-corner" aria-hidden="true">→</span>
                </NavLink>
            }
            else
            {
                <article class="subject-card home-subject-card is-disabled accent-@subject.Accent" aria-label="@subject.Title — netrukus">
                <span class="subject-card-icon icon-@subject.Accent" aria-hidden="true"><GameIcon Key="@subject.Title" /></span>
                <span class="subject-card-copy">
                    <strong>@subject.Title</strong>
                    <small>@subject.Description</small>
                    <span class="home-subject-count">@subject.ActivityCount @ActivityLabel(subject.ActivityCount)</span>
                </span>
                <span class="subject-card-corner subject-card-corner-disabled">Netrukus</span>
                </article>
            }
        }
        </div>
    </section>

    <section class="home-insights" aria-label="Tavo pažanga">
        <article class="home-progress-card">
            <div class="home-progress-art" aria-hidden="true"><span>＋</span><span>×</span><span>−</span><i></i></div>
            <div class="home-progress-copy">
                <p class="home-progress-label">✦ Tavo pažanga</p>
                <strong>@ProgressPercent%</strong>
                <span>@progress.GamesCompleted iš 25 žaidimų tikslo</span>
                <div class="home-progress-track"><i style="width:@ProgressPercent%"></i></div>
            </div>
        </article>
        <article class="home-week-card">
            <div class="home-insight-heading"><span aria-hidden="true">▦</span><strong>Savaitės aktyvumas</strong></div>
            <div class="home-week-days">
                @for (var index = 0; index < WeekdayLabels.Length; index++)
                {
                    var day = WeekStart.AddDays(index);
                    var active = GamesOn(day) > 0;
                    <div class="home-week-day @(active ? "is-active" : "")">
                        <span>@WeekdayLabels[index]</span>
                        <i>@(active ? "✓" : "")</i>
                    </div>
                }
                <div class="home-week-streak"><FlameIcon /><strong>@progress.Streak</strong><small>dienų iš eilės!</small></div>
            </div>
        </article>
        <article class="home-latest-card">
            <div class="home-insight-heading"><span aria-hidden="true">🏆</span><strong>Paskutinė veikla</strong></div>
            @if (LatestResult is { } result)
            {
                <span class="home-latest-badge">✦</span>
                <div><strong>@result.GameTitle</strong><small>@result.Accuracy% tikslumas · @result.PlayedAt.ToLocalTime().ToString("yyyy-MM-dd")</small></div>
            }
            else
            {
                <span class="home-latest-badge">🌱</span>
                <div><strong>Pirmas žaidimas laukia!</strong><small>Pasirink dalyką ir pradėk mokytis.</small></div>
            }
        </article>
    </section>
</section>

@code {
    private StudentProgress progress = new();
    private bool showLevels;
    private bool signedIn;
    private LevelDefinition CurrentLevel => LevelCatalog.All.Last(level => level.RequiredXp <= progress.Xp);
    private LevelDefinition? NextLevel => LevelCatalog.All.FirstOrDefault(level => level.RequiredXp > progress.Xp);
    private int LevelProgress => NextLevel is null ? 100 : Math.Clamp((progress.Xp - CurrentLevel.RequiredXp) * 100 / (NextLevel.RequiredXp - CurrentLevel.RequiredXp), 5, 100);
    private int ProgressPercent => Math.Clamp(progress.GamesCompleted * 4, 0, 100);
    private GameResult? LatestResult => progress.RecentResults.OrderByDescending(result => result.PlayedAt).FirstOrDefault();
    private DateTime WeekStart => DateTime.Today.AddDays(-(((int)DateTime.Today.DayOfWeek + 6) % 7));
    private static string[] WeekdayLabels { get; } = ["Pr", "An", "Tr", "Kt", "Pn", "Št", "Sk"];
    private int GamesOn(DateTime day) => progress.RecentResults.Count(result => result.PlayedAt.ToLocalTime().Date == day.Date);
    private static string ActivityLabel(int count) => count switch { 1 => "pratimas", 0 => "pratimų", _ => "pratimai" };
    private IReadOnlyList<SubjectCard> SubjectCards =>
    [
        Subject("Lietuvių kalba", "violet", "Lavink kalbos žinias!", "/lietuviu-kalba"),
        Subject("Matematika", "blue", "Skaičiuok ir tobulėk!", "/matematika"),
        Subject("Anglų kalba", "mint", "Mokykis anglų kalbos lengvai!", "/"),
        Subject("Istorija", "orange", "Atrask praeitį!", "/"),
        Subject("Gamtos mokslai", "green", "Pažink pasaulį!", "/"),
        Subject("Informatika", "cyan", "Programuok ir kurk!", "/")
    ];

    private SubjectCard Subject(string title, string accent, string description, string href)
    {
        var matches = Catalog.Games.Where(game => game.Subject == title).ToList();
        var readyCount = matches.Count(game => game.Status == GameStatus.Ready);
        return new SubjectCard(title, accent, description, href, readyCount > 0, readyCount);
    }

    protected override async Task OnInitializedAsync()
    {
        signedIn = await AuthSvc.IsAuthenticatedAsync();
        progress = await Progress.GetAsync();
        Progress.Changed += HandleProgressChanged;
    }

    private void HandleProgressChanged() => _ = InvokeAsync(async () =>
    {
        progress = await Progress.GetAsync();
        StateHasChanged();
    });

    public void Dispose()
    {
        Progress.Changed -= HandleProgressChanged;
    }

    private sealed record SubjectCard(string Title, string Accent, string Description, string Href, bool IsReady, int ActivityCount);
}
