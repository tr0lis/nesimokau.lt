@page "/matematika/zaidimai/desningumai"
@using Microsoft.AspNetCore.Components
@using nesimokau.lt.Models
@using nesimokau.lt.Services
@inject ProgressService Progress
@inject ActivityLogService ActivityLog
@inject NavigationManager Navigation
@inject IJSRuntime JS

<PageTitle>Dėsningumai | nesimokau.lt</PageTitle>

@if (loading)
{
    <div class="loading-state"><span class="loader"></span><p>Ruošiame dėsningumų užduotis...</p></div>
}
else if (!started)
{
    <section class="difficulty-screen">
        <button class="button button-ghost prestart-back" @onclick="GoBackToSubject">← Atgal</button>
        <p class="eyebrow">PASIRINK SUNKUMĄ</p>
        <h1>Dėsningumų detektyvas</h1>
        <p class="subtitle">Atrask sekas, dėsningumus ir logines taisykles.</p>
        <div class="difficulty-options">
            @foreach (var option in difficultyOptions)
            {
                <button class="difficulty-option @(selectedDifficulty == option.Key ? "selected" : "")" @onclick="() => selectedDifficulty = option.Key"><span>@option.Icon</span><strong>@option.Title</strong><small>@option.Hint</small></button>
            }
        </div>
        <button class="button button-primary" @onclick="StartGame">Pradėti <span>→</span></button>
    </section>
}
else if (finished)
{
    <section class="result-screen">
        <div class="result-burst">∞</div><p class="eyebrow">Dėsningumai atrakti!</p><h1>Logika sėkminga<span class="gradient-text">!</span></h1>
        <p class="subtitle">Dėsningumų radimas lavina loginį mąstymą ir pastabumą.</p>
        <div class="result-score"><strong>@score</strong><span>taškai</span></div>
        <div class="result-stats"><div><strong>@Accuracy%</strong><span>Tikslumas</span></div><div><strong>⚡ +@earnedXp</strong><span>Uždirbta energija</span></div><div><strong>🪙 +@earnedCoins</strong><span>Uždirbtos monetos</span></div></div>
        <div class="result-actions"><button class="button button-primary" @onclick="Restart">Žaisti dar kartą <span>↗</span></button><button class="button button-ghost" @onclick="GoHome">Grįžti į pradžią</button></div>
    </section>
    @if (levelUp is not null)
    {
        <div class="levelup-overlay">
            <section class="levelup-popup">
                <p class="eyebrow">SVEIKINAME!</p>
                <h2>Pakilai į @levelUp.Number lygį</h2>
                <div class="levelup-badge badge-@levelUp.Color">@levelUp.Badge</div>
                <p>@levelUp.Title</p>
                <button class="button button-primary" @onclick="DismissLevelUp">Puiku!</button>
            </section>
        </div>
    }
}
else if (current is not null)
{
    <NavigationLock OnBeforeInternalNavigation="ConfirmLeave" ConfirmExternalNavigation="true" />
    <div class="game-header"><button class="back-button" @onclick="GoHome" aria-label="Grįžti">←</button><div class="game-title"><span class="game-icon icon-pink">∞</span><div><p class="eyebrow">MATEMATIKA</p><h1>Dėsningumai</h1></div></div><div class="lives" aria-label="Liko gyvybių">@for (var i = 0; i < lives; i++) { <span>♥</span> }</div></div>
    <div class="game-progress"><div><span>@(@index + 1) / @questions.Count</span><span>@score taškai</span></div><div class="progress-track"><span style="width:@ProgressPercent%"></span></div></div>
    <section class="game-panel">
        <div class="tip-card tip-card-inline"><span>∞</span><div><strong>Mažas patarimas</strong><p>Pažiūrėk, kaip kinta skaičiai: ar didėja, ar mažėja, ar kartojasi.</p></div></div>
        <div class="prompt-label"><span class="prompt-pulse"></span> RASK DĖSNINGUMĄ</div>
        <div class="word-problem-card">
            <div class="word-problem-text">@current.Prompt</div>
        </div>
        @if (!string.IsNullOrEmpty(current.Hint))
        {
            <p class="prompt-hint">💡 @current.Hint</p>
        }
        <div class="answer-area"><input @ref="answerInput" @bind="answer" @bind:event="oninput" @onkeydown="HandleKeyDown" placeholder="Įrašyk atsakymą..." autocomplete="off" aria-label="Atsakymas" /><button class="hint-inline-button" @onclick="OpenHintConfirm" disabled="@(feedback is not null || hintUsed || !CanPurchaseHint)" aria-label="Išspręsti">💡</button><span class="hint-inline-tooltip">IŠSPRĘSTI (-100)</span></div>
        @if (feedback is not null)
        {
            <div class="feedback @(isCorrect ? "feedback-good" : "feedback-bad")"><strong>@(isCorrect ? "Teisingai!" : "Dar kartą pagalvok")</strong><span>@feedback</span></div>
            <button class="button button-primary next-button" @onclick="Next">@(isLast ? "Pamatyti rezultatą" : "Kita užduotis") <span>→</span></button>
        }
        else
        { <button class="button button-primary submit-button" @onclick="Submit" disabled="@string.IsNullOrWhiteSpace(answer)">Patikrinti <span>↗</span></button> }
        <p class="keyboard-hint">Patikrinti atsakymą: paspausk <kbd>ENTER</kbd></p>
    </section>
}

@if (showHintConfirm)
{
    <div class="level-modal-backdrop" @onclick="CloseHintConfirm">
        <section class="levels-modal hint-modal" @onclick:stopPropagation="true" role="dialog" aria-modal="true" aria-labelledby="hint-title">
            <button class="modal-close" @onclick="CloseHintConfirm" aria-label="Uždaryti">×</button>
            <p class="eyebrow">PATVIRTINIMAS</p>
            <h2 id="hint-title">Pirkti užuominą?</h2>
            <p class="modal-subtitle">Tai kainuos 100 monetų ir parodys teisingą atsakymą šiai užduočiai. Liko @remainingHints iš 5 šiandien.</p>
            <div class="reset-actions">
                <button class="button button-ghost" @onclick="CloseHintConfirm">Atšaukti</button>
                <button class="button button-primary" @onclick="UseHint" disabled="@(!CanPurchaseHint)">Taip, pirkti</button>
            </div>
        </section>
    </div>
}

@code {
    private readonly (string Key, string Title, string Hint, string Icon)[] difficultyOptions =
    [
        ("Lengvas", "Lengvas", "1-2 klasė", "∞"),
        ("Vidutinis", "Vidutinis", "3 klasė", "∞∞"),
        ("Sudėtingas", "Sudėtingas", "4 klasė", "∞∞∞")
    ];

    private List<MathQuestion> allQuestions = [];
    private List<MathQuestion> questions = [];
    private MathQuestion? current;
    private ElementReference answerInput;
    private string answer = string.Empty;
    private string? feedback;
    private bool isCorrect;
    private bool loading = true;
    private bool started;
    private bool finished;
    private int index;
    private int score;
    private int wrongAnswers;
    private int lives = 3;
    private int earnedXp;
    private int earnedCoins;
    private LevelDefinition? levelUp;
    private string selectedDifficulty = "Lengvas";
    private HashSet<int> sessionSolvedQuestionIds = [];
    private bool showHintConfirm;
    private bool hintUsed;
    private StudentProgress playerProgress = new();
    private int remainingHints;
    private const int HintCost = 100;
    private const int DailyHintLimit = 5;
    private bool isLast => index == questions.Count - 1;
    private int ProgressPercent => questions.Count == 0 ? 0 : (index + 1) * 100 / questions.Count;
    private int Accuracy => questions.Count == 0 ? 0 : Math.Max(0, (questions.Count - wrongAnswers) * 100 / questions.Count);

    protected override async Task OnInitializedAsync()
    {
        var source = MathQuestionFactory.CreateAll().ToList();
        allQuestions = source.Where(q => q.Category == "Modeliai ir sąryšiai").ToList();
        playerProgress = await Progress.GetAsync();
        remainingHints = await Progress.GetRemainingHintsTodayAsync(DailyHintLimit);
        loading = false;
    }

    private bool CanPurchaseHint => playerProgress.Coins >= HintCost && remainingHints > 0;

    private async Task StartGame()
    {
        sessionSolvedQuestionIds = [];
        showHintConfirm = false;
        hintUsed = false;
        playerProgress = await Progress.GetAsync();
        remainingHints = await Progress.GetRemainingHintsTodayAsync(DailyHintLimit);
        var solvedQuestionIds = (await Progress.GetSolvedQuestionIdsAsync("math-patterns")).ToHashSet();

        var pool = allQuestions
            .Where(question => string.Equals(question.Difficulty, selectedDifficulty, StringComparison.OrdinalIgnoreCase))
            .ToList();
        if (pool.Count == 0) pool = allQuestions.ToList();

        var unsolved = pool
            .Where(question => !solvedQuestionIds.Contains(question.Id))
            .OrderBy(_ => Random.Shared.Next())
            .ToList();

        questions = (unsolved.Count > 0 ? unsolved : pool)
            .OrderBy(_ => Random.Shared.Next())
            .Take(10)
            .ToList();
        current = questions.FirstOrDefault();
        started = current is not null;

        if (started)
        {
            await ActivityLog.LogAsync("exercise_started", evt =>
            {
                evt.Subject = "Matematika";
                evt.GameId = "math-patterns";
                evt.GameTitle = "Dėsningumų detektyvas";
                evt.ClassGroup = playerProgress.ClassGroup;
                evt.Payload["taskCount"] = questions.Count;
                evt.Payload["difficulty"] = selectedDifficulty;
            });
        }

        await InvokeAsync(StateHasChanged);
        await Task.Delay(60);
    }

    private async Task Submit()
    {
        if (current is null || feedback is not null || string.IsNullOrWhiteSpace(answer)) return;
        var studentAnswer = answer.Trim();

        var acceptable = new List<string> { current.Answer };
        if (current.AcceptableAnswers is not null) acceptable.AddRange(current.AcceptableAnswers);

        isCorrect = acceptable.Any(a =>
            string.Equals(studentAnswer, a, StringComparison.OrdinalIgnoreCase) ||
            (int.TryParse(studentAnswer, out var sa) && int.TryParse(a, out var ea) && sa == ea));

        if (isCorrect)
        {
            if (hintUsed)
            {
                feedback = "Atsakymas atskleistas už 100 monetų.";
            }
            else
            {
                score += current.Points;
                sessionSolvedQuestionIds.Add(current.Id);
                feedback = "Puikiai! Dėsningumas rastas teisingai.";
            }
        }
        else
        {
            wrongAnswers++;
            lives--;
            feedback = $"Teisingas atsakymas: {current.Answer}. {current.Explanation}";
        }

        await ActivityLog.LogAsync("answer_submitted", evt =>
        {
            evt.Subject = "Matematika";
            evt.GameId = "math-patterns";
            evt.GameTitle = "Dėsningumų detektyvas";
            evt.ClassGroup = playerProgress.ClassGroup;
            evt.IsCorrect = isCorrect;
            evt.QuestionId = current.Id.ToString();
            evt.MistakeType = isCorrect ? null : "pattern";
            evt.Payload["prompt"] = current.Prompt;
            evt.Payload["expected"] = current.Answer;
            evt.Payload["studentAnswer"] = studentAnswer;
            evt.Payload["hintUsed"] = hintUsed;
            evt.Payload["questionIndex"] = index + 1;
        });

        await InvokeAsync(StateHasChanged);
    }

    private void OpenHintConfirm()
    {
        if (feedback is not null || hintUsed || current is null || !CanPurchaseHint) return;
        showHintConfirm = true;
    }

    private void CloseHintConfirm() => showHintConfirm = false;

    private async Task UseHint()
    {
        if (current is null || hintUsed) return;
        var purchase = await Progress.TryPurchaseHintAsync(HintCost, DailyHintLimit);
        if (purchase != ProgressService.HintPurchaseResult.Success)
        {
            showHintConfirm = false;
            playerProgress = await Progress.GetAsync();
            remainingHints = await Progress.GetRemainingHintsTodayAsync(DailyHintLimit);
            return;
        }
        showHintConfirm = false;
        hintUsed = true;
        playerProgress = await Progress.GetAsync();
        remainingHints = await Progress.GetRemainingHintsTodayAsync(DailyHintLimit);
        answer = current.Answer;
        await Submit();
    }

    private async Task HandleKeyDown(KeyboardEventArgs e) { if (e.Key == "Enter") { if (feedback is null) await Submit(); else await Next(); } }

    private async Task Next()
    {
        if (isLast)
        {
            finished = true;
            var savedProgress = await Progress.GetAsync();
            var totalQuestions = allQuestions.Count;
            var alreadyCompleted = totalQuestions > 0 && savedProgress.SolvedQuestionIdsByGame.GetValueOrDefault("math-patterns")?.Distinct().Count() >= totalQuestions;
            var persistedScore = alreadyCompleted ? 0 : score;
            var isRepeat = savedProgress.PracticeMistakeCounts.ContainsKey("math-patterns");
            var previousMistakes = savedProgress.PracticeMistakeCounts.GetValueOrDefault("math-patterns");
            earnedXp = alreadyCompleted ? 0 : isRepeat && Accuracy == 100 ? previousMistakes * 5 : score / 10;
            earnedCoins = alreadyCompleted ? 0 : isRepeat ? (Accuracy == 100 ? previousMistakes : 0) : score / 50 + (Accuracy == 100 ? 2 : 0);
            levelUp = await Progress.SaveResultAsync(new GameResult("math-patterns", "Dėsningumų detektyvas", persistedScore, Accuracy, earnedXp, earnedCoins, DateTime.Now)
            {
                ClassGroup = savedProgress.ClassGroup,
                CorrectAnswers = questions.Count - wrongAnswers,
                IncorrectAnswers = wrongAnswers
            });
            if (Accuracy == 100) await Progress.ClearPracticeTargetAsync("math-patterns");
            else await Progress.SavePracticeTargetAsync("math-patterns", wrongAnswers);
            await Progress.SaveSolvedQuestionIdsAsync("math-patterns", sessionSolvedQuestionIds);
            if (levelUp is not null) await JS.InvokeVoidAsync("nesimokau.celebrateLevelUp");
            return;
        }
        index++;
        current = questions[index];
        answer = string.Empty;
        feedback = null;
        isCorrect = false;
        hintUsed = false;
        await InvokeAsync(StateHasChanged);
        await Task.Delay(50);
        await answerInput.FocusAsync();
    }

    private void Restart() => Navigation.NavigateTo("/matematika/zaidimai/desningumai", true);
    private void GoHome() => Navigation.NavigateTo("/matematika");
    private void GoBackToSubject() => Navigation.NavigateTo("/matematika");
    private void DismissLevelUp() => levelUp = null;
    private async Task ConfirmLeave(LocationChangingContext context) { if (!finished && !await JS.InvokeAsync<bool>("confirm", "Ar tikrai nori išeiti? Rezultatai nebus įskaityti.")) context.PreventNavigation(); }
}