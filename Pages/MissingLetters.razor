@page "/zaidimai/praleistos-raides"
@page "/lietuviu-kalba/{ClassSlug}/praleistos-raides"
@using Microsoft.AspNetCore.Components
@using nesimokau.lt.Models
@using nesimokau.lt.Services
@inject HttpClient Http
@inject IJSRuntime JS
@inject ProgressService Progress
@inject ActivityLogService ActivityLog
@inject NavigationManager Navigation


<PageTitle>Įrašyk praleistas raides | nesimokau.lt</PageTitle>

@if (loading)
{
    <div class="loading-state"><span class="loader"></span><p>Ruošiame žodžius...</p></div>
}
else if (!started)
{
    <section class="difficulty-screen">
        <button class="button button-ghost prestart-back" @onclick="GoBackToSubject">← Atgal</button>
        <p class="eyebrow">PASIRINK REŽIMĄ</p>
        <h1>Praleistos raidės</h1>
        <p class="subtitle">Pasirink, kaip nori spręsti užduotis.</p>

        @if (selectedMode is null)
        {
            <div class="difficulty-options">
                <button class="difficulty-option" @onclick="StartAllMode"><span>∞</span><strong>Visi</strong><small>Spręsti visas esančias užduotis.</small></button>
                <button class="difficulty-option" @onclick='() => selectedMode = "simple"'><span>20</span><strong>Paprastas</strong><small>Paprastas režimas: 20 uždavinių.</small></button>
            </div>
        }
        else if (selectedMode == "simple")
        {
            <p class="eyebrow">PAPRASTAS · PASIRINK SUNKUMĄ</p>
            <div class="difficulty-options">
                @foreach (var option in difficultyOptions)
                {
                    <button class="difficulty-option @(selectedDifficulty == option.Key ? "selected" : "")" @onclick="() => selectedDifficulty = option.Key"><span>@option.Icon</span><strong>@option.Title</strong><small>@option.Hint</small></button>
                }
            </div>
            <div class="result-actions">
                <button class="button button-ghost" @onclick="() => selectedMode = null">← Atgal</button>
                <button class="button button-primary" @onclick="StartSimpleMode">Pradėti <span>→</span></button>
            </div>
        }
    </section>
}
else if (finished)
{
    <section class="result-screen"><div class="result-burst">✓</div><p class="eyebrow">Žaidimas baigtas!</p><h1>Raidės sugrįžo<span class="gradient-text">!</span></h1><p class="subtitle">Puikiai pastebi žodžių rašybos ypatumus.</p><div class="result-score"><strong>@score</strong><span>taškai</span></div><div class="result-stats"><div><strong>@Accuracy%</strong><span>Tikslumas</span></div><div><strong>⚡ +@earnedXp</strong><span>Uždirbta energija</span></div><div><strong>🪙 +@earnedCoins</strong><span>Uždirbtos monetos</span></div></div><div class="result-actions"><button class="button button-primary" @onclick="Restart">Žaisti dar kartą <span>↗</span></button><button class="button button-ghost" @onclick="GoHome">Grįžti į pradžią</button></div></section>
    @if (levelUp is not null)
    {
        <div class="levelup-overlay">
            <section class="levelup-popup">
                <p class="eyebrow">SVEIKINAME!</p>
                <h2>Pakilai į @levelUp.Number lygį</h2>
                <div class="levelup-badge badge-@levelUp.Color">@levelUp.Badge</div>
                <p>@levelUp.Title</p>
                <button class="button button-primary" @onclick="DismissLevelUp">Puiku!</button>
            </section>
        </div>
    }
}
else if (current is not null)
{
    <NavigationLock OnBeforeInternalNavigation="ConfirmLeave" ConfirmExternalNavigation="true" />
    <div class="game-header"><button class="back-button" @onclick="GoHome" aria-label="Grįžti">←</button><div class="game-title"><span class="game-icon icon-orange">_</span><div><p class="eyebrow">LIETUVIŲ KALBA</p><h1>Įrašyk praleistas raides</h1></div></div></div>
    <div class="game-progress"><div><span>@(@index + 1) / @questions.Count</span><span>@score taškai</span></div><div class="progress-track"><span style="width:@ProgressPercent%"></span></div></div>
    <section class="game-panel"><div class="tip-card tip-card-inline"><span>✦</span><div><strong>Mažas patarimas</strong><p>Perskaityk visą žodį ir įrašyk trūkstamą raidę.</p></div></div><div class="prompt-label"><span class="prompt-pulse"></span> ĮRAŠYK PRALEISTĄ RAIDĘ</div><div class="missing-pattern">@current.Pattern</div><p class="prompt-hint">Įrašyk trūkstamą raidę arba iki 3 simbolių.</p><div class="answer-area single-letter-answer"><input @ref="answerInput" @bind="answer" @bind:event="oninput" @onkeydown="HandleKeyDown" maxlength="3" placeholder="?" autocomplete="off" aria-label="Trūkstama raidė" /><button class="hint-inline-button" @onclick="OpenHintConfirm" disabled="@(feedback is not null || hintUsed || !CanPurchaseHint)" aria-label="Išspręsti">💡</button><span class="hint-inline-tooltip">IŠSPRĘSTI (-100)</span></div>@if (feedback is not null) { <div class="feedback @(isCorrect ? "feedback-good" : "feedback-bad")"><strong>@(isCorrect ? "Teisingai!" : "Pabandyk dar")</strong><span>@feedback</span></div><button class="button button-primary next-button" @onclick="Next">@(isLast ? "Pamatyti rezultatą" : "Kitas žodis") <span>→</span></button> } else { <button class="button button-primary submit-button" @onclick="Submit" disabled="@string.IsNullOrWhiteSpace(answer)">Patikrinti <span>↗</span></button> }<p class="keyboard-hint">Patikrinti atsakymą: paspausk <kbd>ENTER</kbd></p></section>
}

@if (showHintConfirm)
{
    <div class="level-modal-backdrop" @onclick="CloseHintConfirm">
        <section class="levels-modal hint-modal" @onclick:stopPropagation="true" role="dialog" aria-modal="true" aria-labelledby="hint-title">
            <button class="modal-close" @onclick="CloseHintConfirm" aria-label="Uždaryti">×</button>
            <p class="eyebrow">PATVIRTINIMAS</p>
            <h2 id="hint-title">Pirkti užuominą?</h2>
            <p class="modal-subtitle">Tai kainuos 100 monetų ir parodys teisingą atsakymą šiai užduočiai. Liko @remainingHints iš 5 šiandien.</p>
            <div class="reset-actions">
                <button class="button button-ghost" @onclick="CloseHintConfirm">Atšaukti</button>
                <button class="button button-primary" @onclick="UseHint" disabled="@(!CanPurchaseHint)">Taip, pirkti</button>
            </div>
        </section>
    </div>
}

@code {
    private readonly (string Key, string Title, string Hint, string Icon)[] difficultyOptions =
    [
        ("Lengvas", "Lengvas", "A1-A2 pagrindai", "★"),
        ("Vidutinis", "Vidutinis", "B1-B2 praktika", "★★"),
        ("Sudėtingas", "Sudėtingas", "C1-C2 iššūkis", "★★★")
    ];

    private List<MissingLettersQuestion> allQuestions = [];
    private List<MissingLettersQuestion> questions = [];
    private MissingLettersQuestion? current;
    private ElementReference answerInput;
    private string answer = string.Empty;
    private string? feedback;
    private bool isCorrect;
    private bool loading = true;
    private bool started;
    private bool finished;
    private int index;
    private int score;
    private int wrongAnswers;
    private int earnedXp;
    private int earnedCoins;
    private LevelDefinition? levelUp;
    private string selectedDifficulty = "Lengvas";
    private string? selectedMode;
    private bool simpleMode;
    private const int SimpleModeTaskCount = 20;
    private HashSet<int> sessionSolvedQuestionIds = [];
    private bool showHintConfirm;
    private bool hintUsed;
    private StudentProgress playerProgress = new();
    private int remainingHints;
    private const int HintCost = 100;
    private const int DailyHintLimit = 5;
    [Parameter] public string? ClassSlug { get; set; }
    [SupplyParameterFromQuery(Name = "level")] public string? LevelSlug { get; set; }
    private bool isLast => index == questions.Count - 1;
    private int ProgressPercent => questions.Count == 0 ? 0 : (index + 1) * 100 / questions.Count;
    private int Accuracy => questions.Count == 0 ? 0 : Math.Max(0, (questions.Count - wrongAnswers) * 100 / questions.Count);

    protected override async Task OnInitializedAsync()
    {
        allQuestions = await Http.GetFromJsonAsync<List<MissingLettersQuestion>>("data/missing-letters.json") ?? [];
        selectedDifficulty = ResolveDifficultyFromLevel(LevelSlug);
        playerProgress = await Progress.GetAsync();
        remainingHints = await Progress.GetRemainingHintsTodayAsync(DailyHintLimit);
        loading = false;
    }

    private bool CanPurchaseHint => playerProgress.Coins >= HintCost && remainingHints > 0;

    private async Task StartGame()
    {
        sessionSolvedQuestionIds = [];
        showHintConfirm = false;
        hintUsed = false;
        playerProgress = await Progress.GetAsync();
        remainingHints = await Progress.GetRemainingHintsTodayAsync(DailyHintLimit);
        var solvedQuestionIds = (await Progress.GetSolvedQuestionIdsAsync("missing-letters")).ToHashSet();

        var pool = allQuestions.ToList();
        if (simpleMode)
        {
            pool = allQuestions
                .Where(question => string.Equals(question.Difficulty, selectedDifficulty, StringComparison.OrdinalIgnoreCase))
                .ToList();
            if (pool.Count == 0) pool = allQuestions.ToList();
        }

        var unsolved = pool
            .Where(question => !solvedQuestionIds.Contains(question.Id))
            .OrderBy(_ => Random.Shared.Next())
            .ToList();

        var sequence = (unsolved.Count > 0 ? unsolved : pool)
            .OrderBy(_ => Random.Shared.Next());

        questions = simpleMode
            ? sequence.Take(Math.Min(SimpleModeTaskCount, pool.Count)).ToList()
            : sequence.ToList();
        current = questions.FirstOrDefault();
        started = current is not null;

        if (started)
        {
            await ActivityLog.LogAsync("exercise_started", evt =>
            {
                evt.Subject = "Lietuvių kalba";
                evt.GameId = "missing-letters";
                evt.GameTitle = "Įrašyk praleistas raides";
                evt.ClassGroup = ParseClassGroup(playerProgress.ClassGroup);
                evt.Payload["taskCount"] = questions.Count;
                evt.Payload["mode"] = simpleMode ? "simple" : "all";
                if (simpleMode) evt.Payload["difficulty"] = selectedDifficulty;
            });
        }

        await InvokeAsync(StateHasChanged);
    }

    private async Task Submit()
    {
        if (current is null || feedback is not null || string.IsNullOrWhiteSpace(answer)) return;
        var studentAnswer = answer.Trim();
        isCorrect = string.Equals(answer.Trim(), current.MissingLetters, StringComparison.OrdinalIgnoreCase);
        if (isCorrect)
        {
            if (hintUsed)
            {
                feedback = "Atsakymas atskleistas už 100 monetų.";
            }
            else
            {
                score += 100;
                sessionSolvedQuestionIds.Add(current.Id);
                feedback = $"Teisinga. {current.Answer}";
            }
        }
        else { wrongAnswers++; feedback = $"Neteisinga. Teisinga frazė: {current.Answer}"; }

        await ActivityLog.LogAsync("answer_submitted", evt =>
        {
            evt.Subject = "Lietuvių kalba";
            evt.GameId = "missing-letters";
            evt.GameTitle = "Įrašyk praleistas raides";
            evt.ClassGroup = ParseClassGroup(playerProgress.ClassGroup);
            evt.IsCorrect = isCorrect;
            evt.QuestionId = current.Id.ToString();
            evt.MistakeType = isCorrect ? null : "missing_letters";
            evt.Payload["pattern"] = current.Pattern;
            evt.Payload["expected"] = current.MissingLetters;
            evt.Payload["studentAnswer"] = studentAnswer;
            evt.Payload["hintUsed"] = hintUsed;
            evt.Payload["questionIndex"] = index + 1;
        });

        await InvokeAsync(StateHasChanged);
    }

    private void OpenHintConfirm()
    {
        if (feedback is not null || hintUsed || current is null || !CanPurchaseHint) return;
        showHintConfirm = true;
    }

    private void CloseHintConfirm() => showHintConfirm = false;

    private async Task UseHint()
    {
        if (current is null || hintUsed) return;

        var purchase = await Progress.TryPurchaseHintAsync(HintCost, DailyHintLimit);
        if (purchase != ProgressService.HintPurchaseResult.Success)
        {
            showHintConfirm = false;
            playerProgress = await Progress.GetAsync();
            remainingHints = await Progress.GetRemainingHintsTodayAsync(DailyHintLimit);
            return;
        }

        showHintConfirm = false;
        hintUsed = true;
        playerProgress = await Progress.GetAsync();
        remainingHints = await Progress.GetRemainingHintsTodayAsync(DailyHintLimit);
        answer = current.MissingLetters;
        await Submit();
    }

    private async Task HandleKeyDown(KeyboardEventArgs e) { if (e.Key == "Enter") { if (feedback is null) await Submit(); else await Next(); } }

    private async Task Next()
    {
        if (isLast)
        {
            finished = true;
            var savedProgress = await Progress.GetAsync();
            var isRepeat = savedProgress.PracticeMistakeCounts.ContainsKey("missing-letters");
            var previousMistakes = savedProgress.PracticeMistakeCounts.GetValueOrDefault("missing-letters");
            var totalQuestions = allQuestions.Count;
            var alreadyCompleted = totalQuestions > 0 && savedProgress.SolvedQuestionIdsByGame.GetValueOrDefault("missing-letters")?.Distinct().Count() >= totalQuestions;
            earnedXp = alreadyCompleted ? 0 : isRepeat && Accuracy == 100 ? previousMistakes * EnergyPerCorrect : score / 100 * EnergyPerCorrect;
            earnedCoins = alreadyCompleted ? 0 : isRepeat ? (Accuracy == 100 ? previousMistakes * CoinsPerCorrect : 0) : score / 100 * CoinsPerCorrect + (Accuracy == 100 ? 2 : 0);
            levelUp = await Progress.SaveResultAsync(new GameResult("missing-letters", "Įrašyk praleistas raides", score, Accuracy, earnedXp, earnedCoins, DateTime.Now)
            {
                ClassGroup = ParseClassGroup(savedProgress.ClassGroup),
                CorrectAnswers = questions.Count - wrongAnswers,
                IncorrectAnswers = wrongAnswers
            });
            if (Accuracy == 100) await Progress.ClearPracticeTargetAsync("missing-letters");
            else await Progress.SavePracticeTargetAsync("missing-letters", wrongAnswers);
            await Progress.SaveSolvedQuestionIdsAsync("missing-letters", sessionSolvedQuestionIds);
            if (levelUp is not null) await JS.InvokeVoidAsync("nesimokau.celebrateLevelUp");
            return;
        }
        index++; current = questions[index]; answer = string.Empty; feedback = null; isCorrect = false; hintUsed = false; await InvokeAsync(StateHasChanged); await Task.Delay(50); await answerInput.FocusAsync();
    }

    private void Restart() => Navigation.NavigateTo(RouteBase(), true);
    private async Task StartAllMode()
    {
        simpleMode = false;
        selectedMode = "all";
        await StartGame();
    }

    private async Task StartSimpleMode()
    {
        simpleMode = true;
        await StartGame();
    }

    private void GoHome() => Navigation.NavigateTo(ClassSlug is null ? "/" : "/lietuviu-kalba");
    private void GoBackToSubject() => Navigation.NavigateTo("/lietuviu-kalba");
    private int EnergyPerCorrect => 10;
    private int CoinsPerCorrect => 2;
    private string RouteBase() => ClassSlug is null ? "zaidimai/praleistos-raides" : $"lietuviu-kalba/{ClassSlug}/praleistos-raides";
    private static string ResolveDifficultyFromLevel(string? level)
        => level?.Trim().ToLowerInvariant() switch
        {
            "a1-a2" => "Lengvas",
            "b1-b2" => "Vidutinis",
            "c1-c2" => "Sudėtingas",
            _ => "Lengvas"
        };

    private string ParseClassGroup(string fallback)
    {
        if (string.IsNullOrWhiteSpace(ClassSlug)) return fallback;
        var match = System.Text.RegularExpressions.Regex.Match(ClassSlug, @"^(\d+)-(\d+)-klases$");
        return match.Success ? $"{match.Groups[1].Value}-{match.Groups[2].Value}" : fallback;
    }
    private void DismissLevelUp() => levelUp = null;
    private async Task ConfirmLeave(LocationChangingContext context) { if (!finished && !await JS.InvokeAsync<bool>("confirm", "Ar tikrai nori išeiti? Rezultatai nebus įskaityti.")) context.PreventNavigation(); }
}
